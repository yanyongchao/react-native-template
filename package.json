{
  "name": "my-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "EXPO_NO_DOTENV=1 dotenvx run -f .env.development -- expo start",
    "start:dev": "EXPO_NO_DOTENV=1 dotenvx run -f .env.development -- expo start",
    "start:staging": "EXPO_NO_DOTENV=1 dotenvx run -f .env.staging -- expo start",
    "start:prod": "EXPO_NO_DOTENV=1 dotenvx run -f .env.production -- expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "EXPO_NO_DOTENV=1 dotenvx run -f .env.development -- expo start --android",
    "android:dev": "EXPO_NO_DOTENV=1 dotenvx run -f .env.development -- expo start --android",
    "android:staging": "EXPO_NO_DOTENV=1 dotenvx run -f .env.staging -- expo start --android",
    "android:prod": "EXPO_NO_DOTENV=1 dotenvx run -f .env.production -- expo start --android",
    "ios": "EXPO_NO_DOTENV=1 dotenvx run -f .env.development -- expo start --ios",
    "ios:dev": "EXPO_NO_DOTENV=1 dotenvx run -f .env.development -- expo start --ios",
    "ios:staging": "EXPO_NO_DOTENV=1 dotenvx run -f .env.staging -- expo start --ios",
    "ios:prod": "EXPO_NO_DOTENV=1 dotenvx run -f .env.production -- expo start --ios",
    "web": "EXPO_NO_DOTENV=1 dotenvx run -f .env.development -- expo start --web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.25",
    "expo-constants": "~18.0.10",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.10",
    "expo-linking": "~8.0.9",
    "expo-router": "~6.0.15",
    "expo-splash-screen": "~31.0.11",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.8",
    "expo-web-browser": "~15.0.9",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "3.3.2"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.51.1",
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
